# Maintainer: John Googol Mylchreest <jmylchreest@gmail.com>
pkgname=histui-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Notification history browser and daemon for Linux desktops (prebuilt binaries)"
arch=('x86_64')
url="https://github.com/jmylchreest/histui"
license=('MIT')
depends=('gtk4' 'glib2')
provides=('histui' 'histuid')
conflicts=('histui')
source=(
    "histui-${pkgver}::https://github.com/jmylchreest/histui/releases/download/v${pkgver}/histui-linux-amd64"
    "histuid-${pkgver}::https://github.com/jmylchreest/histui/releases/download/v${pkgver}/histuid-linux-amd64"
    "histuid.service::https://raw.githubusercontent.com/jmylchreest/histui/v${pkgver}/contrib/histuid.service"
    "histuid-monitor.service::https://raw.githubusercontent.com/jmylchreest/histui/v${pkgver}/contrib/histuid-monitor.service"
    "LICENSE-${pkgver}::https://raw.githubusercontent.com/jmylchreest/histui/v${pkgver}/LICENSE"
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 "histui-${pkgver}" "${pkgdir}/usr/bin/histui"
    install -Dm755 "histuid-${pkgver}" "${pkgdir}/usr/bin/histuid"
    install -Dm644 "histuid.service" "${pkgdir}/usr/lib/systemd/user/histuid.service"
    install -Dm644 "histuid-monitor.service" "${pkgdir}/usr/lib/systemd/user/histuid-monitor.service"
    install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
