FROM docker.io/library/fedora:rawhide
RUN dnf install -y gtk4 libadwaita gtk4-layer-shell alsa-lib sway swaybg grim dbus-daemon python3-dbus python3-pillow python3-gobject wayland-devel wayland-utils gcc pkgconf-pkg-config dejavu-sans-fonts && setcap -r /usr/bin/sway && dnf clean all
ENV GTK_A11Y=none
