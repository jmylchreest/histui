diff --git a/tests/histui_lifecycle/lifecycle_test.go b/tests/histui_lifecycle/lifecycle_test.go
new file mode 100644
index 0000000..b9dfcf4
--- /dev/null
+++ b/tests/histui_lifecycle/lifecycle_test.go
@@ -0,0 +1,297 @@
+package lifecycle_test
+
+import (
+	"codeberg.org/puregotk/puregotk/v4/glib"
+	"codeberg.org/puregotk/puregotk/v4/gobject"
+	"codeberg.org/puregotk/puregotk/v4/gtk"
+	"fmt"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func initGTK(t *testing.T) {
+	t.Helper()
+	runtime.LockOSThread()
+	t.Cleanup(runtime.UnlockOSThread)
+	if !gtk.InitCheck() {
+		t.Fatal("test requires an isolated display")
+	}
+}
+func TestSignalDisconnectStress(t *testing.T) {
+	initGTK(t)
+	calls := 0
+	for i := 0; i < 4000; i++ {
+		b := gtk.NewButton()
+		cb := func(gobject.Object, uintptr) { calls++ }
+		h := b.ConnectNotify(&cb)
+		before := calls
+		b.SetLabel("changed")
+		if calls <= before {
+			t.Fatal("signal did not fire")
+		}
+		b.DisconnectSignal(h)
+		before = calls
+		b.SetLabel("disconnected")
+		if calls != before {
+			t.Fatal("disconnected signal fired")
+		}
+		b.Unref()
+		if i%500 == 0 {
+			runtime.GC()
+			t.Logf("completed %d signal cycles", i)
+		}
+	}
+	if calls < 4000 {
+		t.Fatalf("got %d calls, want at least 4000", calls)
+	}
+}
+func TestSignalDestroyStress(t *testing.T) {
+	initGTK(t)
+	for i := 0; i < 4000; i++ {
+		b := gtk.NewButton()
+		cb := func(gobject.Object, uintptr) {}
+		b.ConnectNotify(&cb)
+		b.Unref()
+		if i%500 == 0 {
+			runtime.GC()
+			t.Logf("completed %d destruction cycles", i)
+		}
+	}
+}
+func TestIdleCompletionStress(t *testing.T) {
+	initGTK(t)
+	context := glib.MainContextDefault()
+	for i := 0; i < 4000; i++ {
+		done := false
+		cb := glib.SourceFunc(func(uintptr) bool { done = true; return false })
+		glib.IdleAdd(&cb, 0)
+		deadline := time.Now().Add(time.Second)
+		for !done && time.Now().Before(deadline) {
+			context.Iteration(false)
+		}
+		if !done {
+			t.Fatal("idle not dispatched")
+		}
+		if i%500 == 0 {
+			runtime.GC()
+			t.Logf("completed %d idle cycles", i)
+		}
+	}
+}
+func TestSourceCancelStress(t *testing.T) {
+	initGTK(t)
+	for i := 0; i < 4000; i++ {
+		cb := glib.SourceFunc(func(uintptr) bool { t.Error("cancelled source ran"); return false })
+		id := glib.TimeoutAdd(60000, &cb, 0)
+		if !glib.SourceRemove(id) {
+			t.Fatal("source removal failed")
+		}
+		if i%500 == 0 {
+			runtime.GC()
+			t.Logf("completed %d cancellation cycles", i)
+		}
+	}
+}
+
+func TestSharedSignalCallback(t *testing.T) {
+	initGTK(t)
+	a, b := gtk.NewButton(), gtk.NewButton()
+	defer a.Unref()
+	defer b.Unref()
+	calls := 0
+	cb := func(gobject.Object, uintptr) { calls++ }
+	ha := a.ConnectNotify(&cb)
+	hb := b.ConnectNotify(&cb)
+	a.DisconnectSignal(ha)
+	before := calls
+	b.SetLabel("still alive")
+	if calls <= before {
+		t.Fatal("shared callback released too soon")
+	}
+	b.DisconnectSignal(hb)
+	hc := a.ConnectNotify(&cb)
+	before = calls
+	a.SetLabel("reconnected")
+	if calls <= before {
+		t.Fatal("callback cannot reconnect")
+	}
+	a.DisconnectSignal(hc)
+}
+func TestSignalDisconnectDuringCallback(t *testing.T) {
+	initGTK(t)
+	b := gtk.NewButton()
+	defer b.Unref()
+	calls := 0
+	disconnect := func() {}
+	cb := func(gobject.Object, uintptr) { calls++; disconnect() }
+	h := b.ConnectNotify(&cb)
+	disconnect = func() { b.DisconnectSignal(h) }
+	b.SetLabel("self disconnect")
+	b.SetLabel("quiet")
+	if calls != 1 {
+		t.Fatalf("got %d callbacks", calls)
+	}
+}
+func TestSourceUserDataAndDestroy(t *testing.T) {
+	initGTK(t)
+	context := glib.MainContextDefault()
+	calls, destructions := 0, 0
+	fn := glib.SourceFunc(func(data uintptr) bool {
+		if data != 12345 {
+			t.Errorf("data %d", data)
+		}
+		calls++
+		return false
+	})
+	destroy := glib.DestroyNotify(func(data uintptr) {
+		if data != 12345 {
+			t.Errorf("destroy data %d", data)
+		}
+		destructions++
+	})
+	glib.IdleAddFull(200, &fn, 12345, &destroy)
+	deadline := time.Now().Add(time.Second)
+	for destructions == 0 && time.Now().Before(deadline) {
+		context.Iteration(false)
+	}
+	if calls != 1 || destructions != 1 {
+		t.Fatalf("completion: calls=%d destroys=%d", calls, destructions)
+	}
+	glib.TimeoutAddFull(0, 60000, &fn, 12345, &destroy)
+	if !glib.SourceRemoveByUserData(12345) {
+		t.Fatal("native user-data lookup broken")
+	}
+	if calls != 1 || destructions != 2 {
+		t.Fatalf("cancel: calls=%d destroys=%d", calls, destructions)
+	}
+}
+
+func TestCallbackCapturesReleased(t *testing.T) {
+	initGTK(t)
+	var released atomic.Int64
+	context := glib.MainContextDefault()
+	for i := 0; i < 400; i++ {
+		func() {
+			data := new([4096]byte)
+			runtime.SetFinalizer(data, func(*[4096]byte) { released.Add(1) })
+			b := gtk.NewButton()
+			cb := func(gobject.Object, uintptr) { runtime.KeepAlive(data) }
+			b.ConnectNotify(&cb)
+			b.Unref()
+		}()
+		func() {
+			data := new([4096]byte)
+			runtime.SetFinalizer(data, func(*[4096]byte) { released.Add(1) })
+			done := false
+			fn := glib.SourceFunc(func(uintptr) bool { runtime.KeepAlive(data); done = true; return false })
+			glib.IdleAdd(&fn, 0)
+			for !done {
+				context.Iteration(false)
+			}
+		}()
+	}
+	deadline := time.Now().Add(3 * time.Second)
+	for released.Load() < 800 && time.Now().Before(deadline) {
+		runtime.GC()
+		time.Sleep(10 * time.Millisecond)
+	}
+	if got := released.Load(); got != 800 {
+		t.Fatalf("only %d/800 captured payloads released", got)
+	}
+}
+
+func TestConcurrentSourceCancellation(t *testing.T) {
+	initGTK(t)
+	var workers sync.WaitGroup
+	var destroyed atomic.Int64
+	for g := 0; g < 8; g++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for i := 0; i < 600; i++ {
+				fn := glib.SourceFunc(func(uintptr) bool { return false })
+				notify := glib.DestroyNotify(func(uintptr) { destroyed.Add(1) })
+				id := glib.TimeoutAddFull(0, 60000, &fn, 0, &notify)
+				if !glib.SourceRemove(id) {
+					t.Error("concurrent removal failed")
+				}
+			}
+		}()
+	}
+	workers.Wait()
+	if destroyed.Load() != 4800 {
+		t.Fatalf("destroyed %d sources", destroyed.Load())
+	}
+}
+
+func TestGenericSignalReconnect(t *testing.T) {
+	initGTK(t)
+	b := gtk.NewButton()
+	defer b.Unref()
+	calls := 0
+	cb := func() { calls++ }
+	for i := 0; i < 100; i++ {
+		h := b.ConnectSignal("notify", &cb)
+		before := calls
+		b.SetLabel(fmt.Sprint(i))
+		if calls <= before {
+			t.Fatal("reconnected generic callback did not fire")
+		}
+		b.DisconnectSignal(h)
+	}
+}
+
+func TestOnceAndSecondsSources(t *testing.T) {
+	initGTK(t)
+	context := glib.MainContextDefault()
+	calls := 0
+	fn := glib.SourceOnceFunc(func(data uintptr) {
+		if data != 123 {
+			t.Errorf("data %d", data)
+		}
+		calls++
+	})
+	glib.IdleAddOnce(&fn, 123)
+	glib.TimeoutAddOnce(0, &fn, 123)
+	glib.TimeoutAddSecondsOnce(0, &fn, 123)
+	deadline := time.Now().Add(3 * time.Second)
+	for calls < 3 && time.Now().Before(deadline) {
+		context.Iteration(false)
+		time.Sleep(time.Millisecond)
+	}
+	if calls != 3 {
+		t.Fatalf("once calls %d", calls)
+	}
+	normal := glib.SourceFunc(func(uintptr) bool { t.Error("cancelled seconds timer fired"); return false })
+	destroyed := 0
+	destroy := glib.DestroyNotify(func(uintptr) { destroyed++ })
+	a := glib.TimeoutAddSeconds(60, &normal, 0)
+	b := glib.TimeoutAddSecondsFull(0, 60, &normal, 0, &destroy)
+	if !glib.SourceRemove(a) || !glib.SourceRemove(b) || destroyed != 1 {
+		t.Fatal("seconds cancellation failed")
+	}
+}
+func TestSourceSelfRemoval(t *testing.T) {
+	initGTK(t)
+	context := glib.MainContextDefault()
+	calls, destroyed := 0, 0
+	remove := func() {}
+	fn := glib.SourceFunc(func(uintptr) bool { calls++; remove(); return true })
+	destroy := glib.DestroyNotify(func(uintptr) { destroyed++ })
+	id := glib.IdleAddFull(200, &fn, 0, &destroy)
+	remove = func() {
+		if !glib.SourceRemove(id) {
+			t.Error("self removal failed")
+		}
+	}
+	deadline := time.Now().Add(time.Second)
+	for destroyed == 0 && time.Now().Before(deadline) {
+		context.Iteration(false)
+	}
+	if calls != 1 || destroyed != 1 {
+		t.Fatalf("self removal calls=%d destroys=%d", calls, destroyed)
+	}
+}
