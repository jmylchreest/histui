@@ -64,3 +64,39 @@ func (e *Error) Error() string {
 func (e *Error) MessageGo() string {
 	return core.GoString(e.Message)
 }
+
+// IsManagedCallback reports whether generated signal code owns this callback.
+// It does not claim ownership of arbitrary function addresses passed by callers.
+func IsManagedCallback(ref uintptr) bool {
+ callbacks.RLock();defer callbacks.RUnlock()
+ for _,v:=range callbacks.refs {if v==ref{return true}}
+ return false
+}
+// ReleaseManagedCallback is called after the final native GClosure is finalized.
+// Callers must not manually unref callbacks still attached to native objects.
+func ReleaseManagedCallback(ref uintptr){
+ callbacks.Lock();defer callbacks.Unlock()
+ for k,v:=range callbacks.refs {if v==ref {delete(callbacks.refs,k)}}
+ releaseNativeCallback(ref)
+}
+
+// managedSourceCallbacks preserves native user-data semantics, including
+// SourceRemoveByUserData. Both trampoline slots live exactly as long as GSource.
+// It uses two slots per simultaneously live source; completion/cancellation
+// returns them even if the callback is never dispatched.
+func managedSourceCallbacks(fn *SourceFunc, notify *DestroyNotify) (callback, destroy uintptr) {
+ if fn==nil || *fn==nil {panic("nil source callback")}
+ callback=purego.NewCallback(*fn)
+ var onDestroy DestroyNotify
+ if notify!=nil {onDestroy=*notify}
+ destroy=purego.NewCallback(func(data uintptr){
+  defer func(){releaseNativeCallback(callback);releaseNativeCallback(destroy)}()
+  if onDestroy!=nil {onDestroy(data)}
+ })
+ return
+}
+func sourceOnce(fn *SourceOnceFunc) SourceFunc {
+ if fn==nil || *fn==nil {panic("nil source callback")}
+ f:=*fn
+ return func(data uintptr)bool{f(data);return false}
+}
